# Local Postgres. Copy this file to .env or export DATABASE_URL in the shell.
# The daily workflow secret uses the same name and must point at the real database.
DATABASE_URL=postgres://marco:marco@localhost:5432/marco_health

# Stack X live pull (hlth.io.mi.com + sts-hlth.io.mi.com).
# Leave these empty. Export real values in the process environment, or set the
# same names as GitHub Actions secrets for .github/workflows/daily-live-pull.yml.
# Non-empty values in .env are refused and are never loaded.
# serviceToken and ssecurity are obtained at runtime. Do not add them here.
XIAOMI_USER_ID=
XIAOMI_PASS_TOKEN=
XIAOMI_DEVICE_ID=
